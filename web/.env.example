# VITE_* values are compiled into the public JavaScript bundle.
# Only the Worker's public URL belongs here, NEVER OPENAI_API_KEY / INVITE_CODE / AUTH_SECRET.
#
# Development: web/.env.development already sets http://127.0.0.1:8787.
# Production (GitHub Pages): set the repository variable VITE_WORKER_URL in
#   GitHub → Settings → Secrets and variables → Actions → Variables.
# For a local production build you can copy this file to `.env.production.local`.
VITE_WORKER_URL=https://pdf-translator-worker.YOUR-SUBDOMAIN.workers.dev
