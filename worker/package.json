{
  "name": "pdf-translator-worker",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Cloudflare Worker: translation API proxy. Receives JSON text blocks only, never the PDF.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "typescript": "~5.8.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260921.1": true
  }
}
